---
import { slug } from "github-slugger";
import Glyphs from "../glyph/Glyphs.astro";
import { IconCircleFilled } from "@tabler/icons-react";
import {
    fetchAllTomes,
    formatTomeColor,
    getTomeColorIconStyle,
    extractGlyphName,
} from "../../lib/services/tome-service";

const tomes = await fetchAllTomes();
---

<Fragment>
    {tomes.map(tome =>
        <Fragment>
            <h2 id={slug(tome.name)}>
                <span data-bs-toggle="tooltip" data-bs-title={formatTomeColor(tome.color)}>
                    <IconCircleFilled size={24} {...getTomeColorIconStyle(tome.color)} />&nbsp;{tome.name}
                </span>
                <a class="anchor" aria-hidden="true" data-pagefind-ignore="all" aria-label={`${tome.name.toLowerCase()} permalink`} href={`#${slug(tome.name)}`}>#</a>
            </h2>
            <Glyphs glyphs={tome.spell.map(extractGlyphName)} />
            <p class="card-text" style="white-space: pre-line;">{tome.flavour_text}</p>
        </Fragment>
    )}
</Fragment>

<script>
    import { Tooltip } from "bootstrap";
    document.querySelectorAll('[data-bs-toggle="tooltip"]')
        .forEach(el => new Tooltip(el));
</script>
